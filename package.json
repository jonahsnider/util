{
	"name": "@jonahsnider/util",
	"version": "13.0.0",
	"description": "A useful collection of optimized utility functions",
	"homepage": "https://util.jonah.pw/",
	"license": "MIT",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jonahsnider/util.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"docs": "typedoc --options ./typedoc.json",
		"knip": "knip",
		"test": "vp test --run",
		"test:coverage": "vp test --run --coverage",
		"test:dev": "vp test --ui",
		"validate-api": "api-extractor run",
		"validate-api:local": "api-extractor run --local --verbose",
		"prepare": "vp config"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "7.60.0",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "catalog:",
		"knip": "6.43.0",
		"tsd": "0.33.0",
		"typedoc": "0.28.20",
		"typescript": "7.0.2",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"engines": {
		"node": ">=16"
	},
	"packageManager": "pnpm@12.16.1"
}
